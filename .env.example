# Copy to .env and fill in. Never commit .env.

# Strictness profile: loose | tight
PROFILE=tight

# Web app
APP_PASSWORD=choose-a-strong-password
SESSION_SECRET_KEY=generate-a-long-random-string

# Optional tuning overrides
# MIN_PIVOT_SEPARATION=5
# RSI_PERIOD=14
# GAP_GUARD_PCT=35

# Phase 2 — Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
